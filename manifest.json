{
  "manifest_version": 3,
  "name": "Твой плейлист — синхронизация с закладками",
  "version": "1.1",
  "description": "Читает ссылки из папки закладок \"playlist\" и даёт мини-плеер на тулбаре для управления открытой вкладкой плеера.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Твой плейлист"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
